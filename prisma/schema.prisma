generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum SyncStatus { PENDING RUNNING COMPLETED FAILED }
enum SyncType { FULL DAILY CHANNEL VIDEOS PLAYLISTS ANALYTICS TOKEN_REFRESH }

model User { id String @id @default(cuid()) email String @unique name String? image String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt tokens OAuthToken[] channels Channel[] notifications Notification[] recommendations Recommendation[] }
model OAuthToken { id String @id @default(cuid()) userId String provider String @default("google") accessToken String refreshToken String? expiresAt DateTime scopes String[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields:[userId], references:[id], onDelete:Cascade) @@unique([userId, provider]) @@index([expiresAt]) }
model Channel { id String @id youtubeId String @unique userId String title String description String? customUrl String? publishedAt DateTime? uploadsPlaylistId String? thumbnailUrl String? country String? branding Json? lastSyncedAt DateTime? syncCompletedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields:[userId], references:[id], onDelete:Cascade) statistics ChannelStatistics? histories ChannelHistory[] playlists Playlist[] videos Video[] analyticsDaily AnalyticsDaily[] analyticsCountry AnalyticsCountry[] analyticsDevice AnalyticsDevice[] analyticsTraffic AnalyticsTraffic[] syncJobs SyncJob[] syncState SyncState? recommendations Recommendation[] @@index([userId]) @@index([lastSyncedAt]) }
model ChannelStatistics { id String @id @default(cuid()) channelId String @unique viewCount BigInt @default(0) subscriberCount BigInt @default(0) hiddenSubscriberCount Boolean @default(false) videoCount BigInt @default(0) updatedAt DateTime @updatedAt channel Channel @relation(fields:[channelId], references:[id], onDelete:Cascade) }
model ChannelHistory { id String @id @default(cuid()) channelId String capturedAt DateTime @default(now()) viewCount BigInt @default(0) subscriberCount BigInt @default(0) videoCount BigInt @default(0) channel Channel @relation(fields:[channelId], references:[id], onDelete:Cascade) @@unique([channelId, capturedAt]) @@index([channelId]) }
model Playlist { id String @id youtubeId String @unique channelId String title String description String? publishedAt DateTime? thumbnailUrl String? itemCount Int @default(0) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt channel Channel @relation(fields:[channelId], references:[id], onDelete:Cascade) videos PlaylistVideo[] @@index([channelId]) }
model PlaylistVideo { id String @id @default(cuid()) playlistId String videoId String position Int addedAt DateTime? playlist Playlist @relation(fields:[playlistId], references:[id], onDelete:Cascade) video Video @relation(fields:[videoId], references:[id], onDelete:Cascade) @@unique([playlistId, videoId]) @@index([videoId]) }
model Video { id String @id youtubeId String @unique channelId String title String description String? publishedAt DateTime? duration String? definition String? dimension String? caption Boolean @default(false) licensedContent Boolean @default(false) privacyStatus String? uploadStatus String? tags String[] thumbnails Json? categoryId String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt channel Channel @relation(fields:[channelId], references:[id], onDelete:Cascade) statistics VideoStatistics? histories VideoHistory[] analyticsDaily AnalyticsVideoDaily[] playlists PlaylistVideo[] @@index([channelId, publishedAt]) }
model VideoStatistics { id String @id @default(cuid()) videoId String @unique viewCount BigInt @default(0) likeCount BigInt @default(0) commentCount BigInt @default(0) favoriteCount BigInt @default(0) updatedAt DateTime @updatedAt video Video @relation(fields:[videoId], references:[id], onDelete:Cascade) }
model VideoHistory { id String @id @default(cuid()) videoId String capturedAt DateTime @default(now()) viewCount BigInt @default(0) likeCount BigInt @default(0) commentCount BigInt @default(0) video Video @relation(fields:[videoId], references:[id], onDelete:Cascade) @@unique([videoId, capturedAt]) @@index([videoId]) }
model AnalyticsDaily { id String @id @default(cuid()) channelId String day DateTime views BigInt @default(0) likes BigInt @default(0) comments BigInt @default(0) watchTime BigInt @default(0) subscribersGained BigInt @default(0) subscribersLost BigInt @default(0) estimatedRevenue Decimal @default(0) channel Channel @relation(fields:[channelId], references:[id], onDelete:Cascade) @@unique([channelId, day]) @@index([day]) }
model AnalyticsVideoDaily { id String @id @default(cuid()) videoId String day DateTime views BigInt @default(0) likes BigInt @default(0) comments BigInt @default(0) watchTime BigInt @default(0) averageViewDuration BigInt @default(0) estimatedRevenue Decimal @default(0) video Video @relation(fields:[videoId], references:[id], onDelete:Cascade) @@unique([videoId, day]) @@index([day]) }
model AnalyticsCountry { id String @id @default(cuid()) channelId String day DateTime country String views BigInt @default(0) watchTime BigInt @default(0) channel Channel @relation(fields:[channelId], references:[id], onDelete:Cascade) @@unique([channelId, day, country]) @@index([country]) }
model AnalyticsDevice { id String @id @default(cuid()) channelId String day DateTime deviceType String views BigInt @default(0) watchTime BigInt @default(0) channel Channel @relation(fields:[channelId], references:[id], onDelete:Cascade) @@unique([channelId, day, deviceType]) }
model AnalyticsTraffic { id String @id @default(cuid()) channelId String day DateTime sourceType String views BigInt @default(0) watchTime BigInt @default(0) channel Channel @relation(fields:[channelId], references:[id], onDelete:Cascade) @@unique([channelId, day, sourceType]) }
model SyncJob { id String @id @default(cuid()) channelId String? type SyncType status SyncStatus @default(PENDING) step String? error String? startedAt DateTime? completedAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt channel Channel? @relation(fields:[channelId], references:[id], onDelete:SetNull) @@index([channelId, status]) }
model SyncState { id String @id @default(cuid()) channelId String @unique lastFullSyncAt DateTime? lastDailySyncAt DateTime? lastSuccessfulStep String? cursor Json? channel Channel @relation(fields:[channelId], references:[id], onDelete:Cascade) }
model Notification { id String @id @default(cuid()) userId String title String body String readAt DateTime? createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id], onDelete:Cascade) @@index([userId, readAt]) }
model Recommendation { id String @id @default(cuid()) userId String channelId String? kind String title String description String priority Int @default(0) dismissedAt DateTime? createdAt DateTime @default(now()) user User @relation(fields:[userId], references:[id], onDelete:Cascade) channel Channel? @relation(fields:[channelId], references:[id], onDelete:Cascade) @@index([userId, priority]) }
