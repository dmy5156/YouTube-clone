    "express": "^4.21.2",
    "googleapis": "^140.0.1",
    "helmet": "^8.0.0",
    "inngest": "^3.28.0",
    "ioredis": "^5.4.1",
    "morgan": "^1.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.17.10",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.7.2"
  }
